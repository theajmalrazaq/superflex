{
  "name": "superflex",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "npm run build:docs:scripts && vitest run",
    "test:watch": "vitest",
    "typecheck:parsers": "tsc -p tsconfig.parsers.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "wxt prepare && tsc --noEmit && tsc -p tsconfig.parsers.json",
    "dev:docs": "vite --config vite.docs.config.ts",
    "build:docs": "npm run build:docs:scripts && vite build --config vite.docs.config.ts && cp -R docs/res docs/articles docs/reviews.json dist-docs/ && mkdir -p dist-docs/scripts && cp -R docs/scripts/generated dist-docs/scripts/",
    "build:docs:scripts": "esbuild docs/scripts/theme.ts docs/scripts/index.ts docs/scripts/docs.ts --bundle --format=iife --platform=browser --target=es2022 --outdir=docs/scripts/generated --minify"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "agentcomposerui": "0.1.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "8.0.4",
    "lucide-react": "^0.487.0",
    "mdast-util-to-string": "^4.0.0",
    "postcss": "^8.5.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "unified": "^11.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.2.1",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
