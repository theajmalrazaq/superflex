{
  "categories": [
    {
      "title": "### 🤖 Features & Additions",
      "labels": ["feature", "feat", "enhancement"]
    },
    {
      "title": "### ⏰ Fixes & Adjustments",
      "labels": ["fix", "bug"]
    },
    {
      "title": "### 📊 UI, Performance & Refactoring",
      "labels": ["refactor", "style", "perf"]
    },
    {
      "title": "### 🗂️ Architecture, Tooling & Docs",
      "labels": ["chore", "docs", "documentation", "ci", "build"]
    },
    {
      "title": "### 📦 Other Changes",
      "labels": []
    }
  ],
  "ignore_labels": [
    "ignore",
    "skip-changelog"
  ],
  "duplicate_filter": {
    "pattern": ".*",
    "on_property": "title",
    "method": "match"
  },
  "label_extractor": [
    {
      "pattern": "^Merge (pull request|branch).*",
      "on_property": "title",
      "target": "ignore"
    },
    {
      "pattern": "^Closes #.*",
      "on_property": "title",
      "target": "ignore"
    },
    {
      "pattern": "^(\\[[^\\]]+\\]\\s*)?(feat|feature|add|added)\\b(\\([\\w\\-\\.]+\\))?:?\\s*(.*)",
      "on_property": "title",
      "target": "feature"
    },
    {
      "pattern": "^(\\[[^\\]]+\\]\\s*)?(fix|fixed|bug)\\b(\\([\\w\\-\\.]+\\))?:?\\s*(.*)",
      "on_property": "title",
      "target": "fix"
    },
    {
      "pattern": "^(\\[[^\\]]+\\]\\s*)?(refactor|style|perf|improved|performace)\\b(\\([\\w\\-\\.]+\\))?:?\\s*(.*)",
      "on_property": "title",
      "target": "refactor"
    },
    {
      "pattern": "^(\\[[^\\]]+\\]\\s*)?(chore|docs|documentation|ci|build|moved)\\b(\\([\\w\\-\\.]+\\))?:?\\s*(.*)",
      "on_property": "title",
      "target": "chore"
    }
  ],
  "transformers": [
    {
      "pattern": "^(\\[[^\\]]+\\]\\s*)?((feat|feature|add|added|fix|fixed|bug|perf|performance|refactor|style|chore|docs|documentation|ci|build|improved|performace)\\b(\\([\\w\\-\\.]+\\))?:?\\s*(and\\s+)?)*(.*)",
      "target": "$6"
    }
  ],
  "template": "# 🚀 SuperFlex Update\n\n## 🆕 Change Logs\n\n#{{CHANGELOG}}\n\n---\nBuilt on: #{{DATE}}",
  "pr_template": "- #{{TITLE}}",
  "commit_template": "- #{{TITLE}}",
  "empty_template": "# 🚀 SuperFlex Update\n\n## 🆕 Change Logs\n\n- 📦 General maintenance and performance updates\n\n---\nBuilt on: #{{DATE}}"
}
